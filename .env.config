# Mentions légales
## Identité légale
NEXT_PUBLIC_SITE_URL= # URL publique du site (ex. https://exemple.be)
NEXT_PUBLIC_COMPANY_NAME= # Dénomination sociale de l'entité éditrice
NEXT_PUBLIC_COMPANY_LEGAL_FORM= # Forme juridique (SRL, SA, ASBL, indépendant...)
NEXT_PUBLIC_COMPANY_STREET= # Rue et numéro du siège social
NEXT_PUBLIC_COMPANY_POSTAL_CODE= # Code postal du siège social
NEXT_PUBLIC_COMPANY_CITY= # Ville du siège social
NEXT_PUBLIC_COMPANY_COUNTRY= # Pays du siège social
NEXT_PUBLIC_COMPANY_BCE_NUMBER= # Numéro d'entreprise (BCE)
NEXT_PUBLIC_COMPANY_VAT_NUMBER= # Numéro de TVA
NEXT_PUBLIC_COMPANY_DISTRICT= # RPM / Tribunal de l'entreprise
NEXT_PUBLIC_CONTACT_EMAIL= # Email de contact (repris aussi dans la section Contact)
NEXT_PUBLIC_CONTACT_PHONE= # Téléphone de contact
NEXT_PUBLIC_PUBLISHER_NAME= # Prénom et nom du responsable de la publication
NEXT_PUBLIC_PUBLISHER_ROLE= # Fonction du responsable de la publication

## Hébergement
NEXT_PUBLIC_HOSTING_NAME="Vercel Inc"
NEXT_PUBLIC_HOSTING_ADDRESS="440 N Barranca Ave #4133, Covina, CA 91723, United States"
NEXT_PUBLIC_HOSTING_WEBSITE="www.vercel.com"
NEXT_PUBLIC_HOSTING_CONTACT="support@vercel.com"

## Données à caractère personnel
NEXT_PUBLIC_COMPANY_FULL_ADDRESS= # Adresse complète du responsable de traitement (distincte des champs adresse ci-dessus)
NEXT_PUBLIC_DPO_EMAIL= # Email du DPO ou contact vie privée

## Cookies
NEXT_PUBLIC_CONSENT_WITHDRAWAL_METHOD= # Moyen de modifier son consentement (ex. lien vers le bandeau cookies)

## Droit applicable et juridiction
NEXT_PUBLIC_GOVERNING_LAW_COUNTRY= # Droit applicable au site (ex. belge)
NEXT_PUBLIC_JUDICIAL_DISTRICT= # Arrondissement judiciaire compétent

## Contact
NEXT_PUBLIC_MENTIONS_LAST_UPDATED= # Date de dernière mise à jour des mentions légales